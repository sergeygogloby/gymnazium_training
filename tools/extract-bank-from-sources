def pdf_text(path: Path) -> str:
    reader = PdfReader(str(path))
    parts: list[str] = []
    for page in reader.pages:
        parts.append(page.extract_text() or "")
    return "\n".join(parts)


def clean_text(text: str) -> str:
    text = text.replace("\u00ad", "")
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text


def find_unique(pattern: str, *, prefer_tests: bool = True) -> Path | None:
    matches = sorted(SOURCES.rglob(pattern))
    # Drop Riesenie when looking for tests
    if prefer_tests:
        matches = [m for m in matches if not re.search(r"Riesen", m.name, re.I)]
    preferred = [m for m in matches if re.search(r"/[1-6]/", str(m))]
    # Prefer non-lll, then shortest path, then root sources/
    pool = preferred or [m for m in matches if "/lll/" not in str(m)] or matches
    if not pool:
        return None
    # Prefer files with extractable text over near-empty scans
    scored: list[tuple[int, Path]] = []
    for m in pool:
        try:
            n = sum(len(p.extract_text() or "") for p in PdfReader(str(m)).pages[:1])
        except Exception:
            n = 0
        scored.append((n, m))
    scored.sort(key=lambda x: (-x[0], len(str(x[1]))))
    return scored[0][1] if scored and scored[0][0] > 20 else (pool[0] if pool else None)


def find_riesenia(topic: int) -> Path | None:
    for pat in (
        f"*Mudre-predplatne_{topic}_Riesenia*.pdf",
        f"*Mudre-predplatne_{topic}_Riesenie*.pdf",
    ):
        matches = sorted(SOURCES.rglob(pat))
        if matches:
            return matches[0]
    return None


def find_ulohy(topic: int) -> Path | None:
    return find_unique(f"*Mudre-predplatne_{topic}_Ulohy*.pdf")


def split_numbered_blocks(text: str) -> dict[int, str]:
    """Split on item numbers: 'N.' or a lone 'N' line (some exam PDFs)."""
    text = clean_text(text)
    pattern = re.compile(r"(?m)^(?:(?P<n>\d{1,2})\.\s+| *(?P<n2>\d{1,2}) *$)")
    matches = list(pattern.finditer(text))
    # Filter bare-number matches that are not followed by MCQ choices soon
    filtered = []
    for m in matches:
        if m.group("n"):
            filtered.append(m)
            continue
        lookahead = text[m.end() : m.end() + 400]
        if re.search(r"(?m)^[A-Ea-e][\.\)]\s|^[A-Ea-e][\.\)]\t", lookahead):
            filtered.append(m)
    matches = filtered

    blocks: dict[int, str] = {}
    for i, m in enumerate(matches):
        n = int(m.group("n") or m.group("n2"))
        # Skip false positives like "1. pred zašifrovaním" inside stems (keep first wins)
        if n in blocks and n < 3 and len(blocks[n]) > 80:
            continue
        start = m.end()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        body = text[start:end].strip()
        lines = [ln for ln in body.splitlines() if not HEADER_NOISE.search(ln)]
        blocks[n] = "\n".join(lines).strip()
    return blocks


def parse_mcq_block(body: str, *, five_choice: bool = False) -> tuple[str, list[str]] | None:
    """Return (stem, [A,B,C,D(,E) texts]) or None."""
    letters = "ABCDE" if five_choice else "ABCD"
    letter_class = f"[A-{letters[-1]}a-{letters[-1].lower()}]"

    # Collect all choice markers (handles two-column a)/c)/e) layouts)
    markers = list(
        re.finditer(rf"(?m)(?:^|\s)({letter_class})[\.\)]\s*", body)
    )
    # Prefer markers that look like real choices (letter then content)
    by_letter: dict[str, str] = {}
    if len(markers) >= 2:
        for i, m in enumerate(markers):
            L = m.group(1).upper()
            if L not in letters:
                continue
            start = m.end()
            end = markers[i + 1].start() if i + 1 < len(markers) else len(body)
            # Don't let choice text run into the next numbered item heavily
            t = body[start:end]
            t = re.sub(r"\s+", " ", t).strip()
            t = t.strip(" .;\t")
            # Truncate at obvious next-question starts
            t = re.split(r"(?m)\n\d{1,2}\.\s", t)[0].strip()
            if L not in by_letter and t and len(t) < 500:
                by_letter[L] = t

    if len(by_letter) < 2:
        # Fallback: classic line-start A. / A)
        choice_re = re.compile(
            rf"(?m)^({letter_class})[\.\)]\s*(.+?)(?=(?:\n{letter_class}[\.\)]\s)|\Z)",
            re.S,
        )
        for letter, text in choice_re.findall(body):
            L = letter.upper()
            t = re.sub(r"\s+", " ", text).strip().strip(" .;\t")
            if L not in by_letter and t:
                by_letter[L] = t

    if len(by_letter) < 2:
        return None

    # Stem = text before first choice marker
    first_pos = None
    for m in re.finditer(rf"(?mi)(?:^|\s)([Aa])[\.\)]\s", body):
        first_pos = m.start()
        break
    if first_pos is None:
        return None
    stem = body[:first_pos].strip()
    stem = re.sub(r"\s+", " ", stem).strip()
    stem = re.sub(r"^\d+\s+", "", stem).strip()
    if len(stem) < 8:
        return None

    ordered = [by_letter[L] for L in letters if L in by_letter]
    if len(ordered) < 2:
        return None
    return stem, ordered


def parse_solution_block(body: str) -> tuple[str | None, str]:
    """Return (correctKey letter or None, rationale)."""
    body = re.sub(r"\s+", " ", body).strip()
    # "C – rationale", "B (…)", "A. text", "D: text"
    m = re.match(
        r"^([A-E])\s*(?:[\(–—\-.:)]|\()\s*(.*)$",
        body,
        re.I | re.S,
    )
    if m:
        rationale = m.group(2).strip()
        if rationale.endswith(")") and "(" not in rationale[:-1]:
            rationale = rationale[:-1].strip()
        return m.group(1).upper(), rationale
    # "B" alone, or "B Indície: …" (letter + whitespace + rationale)
    m = re.match(r"^([A-E])(?:\s+(.*))?$", body.strip(), re.I | re.S)
    if m:
        return m.group(1).upper(), (m.group(2) or "").strip()
    # Free numeric / text answer without letter
    m = re.match(r"^(\d+)\s*[–—\-.]?\s*(.*)$", body)
    if m and not re.match(r"^[A-E]", body, re.I):
        return None, body
    return None, body


def normalize(s: str) -> str:
    s = s.lower().strip()
    s = re.sub(r"\s+", " ", s)
    s = re.sub(r"[^\wáäčďéíĺľňóôŕšťúýž]+", "", s, flags=re.I)
    return s


def infer_restated_key(body: str, choices: list[str]) -> tuple[str | None, str]:
    """Infer MCQ key from a solution block that restates the question."""
    letters = [chr(65 + i) for i in range(len(choices))]
    # Text after last choice marker
    last = None
    for m in re.finditer(r"(?m)^[A-E]\.\s", body):
        last = m
    after = body[last.end() :] if last else body
    after = HEADER_NOISE.sub(" ", after)
    after_flat = re.sub(r"\s+", " ", after).strip()

    # Elimination: A – … B – … (missing letter = answer)
    mentioned = re.findall(r"(?<![A-Za-z0-9])([A-D])\s*[–—\-]\s+", after_flat[:500])
    if len(mentioned) >= 2:
        miss = [L for L in "ABCD" if L not in set(mentioned)]
        if len(miss) == 1 and miss[0] in letters:
            return miss[0], after_flat[:500]

    # Explicit
    m = re.search(r"[Ss]právn[áo]\s+(?:je\s+)?odpoveď[:\s]+([A-E])", after_flat)
    if m and m.group(1).upper() in letters:
        return m.group(1).upper(), after_flat[:500]

    # Leading letter after choices
    m = re.match(r"^\s*([A-E])\s*[–—\-.:\)]\s+", after)
    if m and m.group(1).upper() in letters:
        return m.group(1).upper(), after_flat[:500]

    # Choice-text match: first short line / phrase equals a choice
    # Take first 1–3 non-empty lines after choices
    candidates: list[str] = []
    for ln in after.splitlines():
        ln = ln.strip()
        if not ln or HEADER_NOISE.search(ln):
            continue
        if re.match(r"^[A-E]\.\s", ln):
            continue
        candidates.append(ln)
        if len(candidates) >= 3:
            break
    blob = " ".join(candidates[:2])
    blob_n = normalize(blob)
    if blob_n:
        best: tuple[int, str] | None = None
        for i, ch in enumerate(choices):
            cn = normalize(ch)
            if not cn:
                continue
            if cn == blob_n or cn in blob_n or blob_n in cn:
                score = min(len(cn), len(blob_n))
                if best is None or score > best[0]:
                    best = (score, letters[i])
        if best and best[0] >= 4:
            return best[1], after_flat[:500]

    # Numeric / short token match against choices
    nums = re.findall(r"\b\d+(?:[.,]\d+)?\b", after_flat[:300])
    for num in nums:
        for i, ch in enumerate(choices):
            if num in ch.replace(" ", ""):
                # Prefer exact-ish
                if normalize(num) in normalize(ch):
                    return letters[i], after_flat[:500]

    return None, after_flat[:500]


def stable_id(topic: str, index: int, stem: str, prefix: str = "bank") -> str:
    h = hashlib.sha1(stem.encode("utf-8")).hexdigest()[:10]
    return f"{prefix}-{topic.lower()}-{index:02d}-{h}"


def make_item(
    *,
    topic_id: str,
    module: str,
    skill: str,
    n: int,
    stem: str,
    choices: list[str],
    key: str,
    rationale: str,
    source_pdf: Path,
    solution_pdf: Path,
    id_prefix: str = "bank",
) -> Item:
    idx = ord(key) - ord("A")
    choice_cells = [f"{chr(65 + i)}. {c}" for i, c in enumerate(choices)]
    if not rationale:
        rationale = f"Správna odpoveď: {key}."
    return Item(
        id=stable_id(topic_id, n, stem, id_prefix),
        stem=stem,
        choices=choice_cells,
        correctKey=key,
        rationale=rationale[:800],
        module=module,
        topic=topic_id,
        skillArea=skill,
        sourceType="bank",
        locale="sk",
        published="true",
        sourcePdf=source_pdf.name,
        solutionPdf=solution_pdf.name,
        itemIndex=n,
    )


def extract_topic(topic: int) -> tuple[list[Item], dict]:
    ulohy = find_ulohy(topic)
    ries = find_riesenia(topic)
    meta = TOPIC_META[topic]
    module, topic_id, skill = meta
    info: dict = {
        "kind": "ulohy",
        "topic": topic,
        "ulohy": str(ulohy) if ulohy else None,
        "riesenia": str(ries) if ries else None,
        "parsed": 0,
        "skipped": 0,
        "reasons": {},
    }
    if not ulohy or not ries:
        info["error"] = "missing ulohy or riesenia"
        return [], info

    q_blocks = split_numbered_blocks(pdf_text(ulohy))
    a_blocks = split_numbered_blocks(pdf_text(ries))

    items: list[Item] = []
    for n, qbody in sorted(q_blocks.items()):
        parsed = parse_mcq_block(qbody)
        if not parsed:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_mcq_choices"
            continue
        stem, choices = parsed
        sol_body = a_blocks.get(n, "")
        key, rationale = parse_solution_block(sol_body) if sol_body else (None, "")
        if not key:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_letter_key"
            continue
        idx = ord(key) - ord("A")
        if idx < 0 or idx >= len(choices):
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = f"key_{key}_out_of_range_{len(choices)}"
            continue
        items.append(
            make_item(
                topic_id=topic_id,
                module=module,
                skill=skill,
                n=n,
                stem=stem,
                choices=choices,
                key=key,
                rationale=rationale,
                source_pdf=ulohy,
                solution_pdf=ries,
                id_prefix="bank",
            )
        )
        info["parsed"] += 1
    return items, info


def extract_letter_key_pair(spec: dict) -> tuple[list[Item], dict]:
    test = find_unique(spec["test"])
    ries_matches = sorted(SOURCES.rglob(spec["riesenie"]))
    ries = ries_matches[0] if ries_matches else None
    info: dict = {
        "kind": "letter-key-test",
        "id": spec["id"],
        "test": str(test) if test else None,
        "riesenie": str(ries) if ries else None,
        "parsed": 0,
        "skipped": 0,
        "reasons": {},
    }
    if not test or not ries:
        info["error"] = "missing test or riesenie"
        return [], info
    if sum(len(p.extract_text() or "") for p in PdfReader(str(test)).pages) < 50:
        info["error"] = "test_pdf_no_text"
        return [], info

    five = bool(spec.get("five_choice"))
    q_blocks = split_numbered_blocks(pdf_text(test))
    a_blocks = split_numbered_blocks(pdf_text(ries))
    items: list[Item] = []
    for n, qbody in sorted(q_blocks.items()):
        if n > 80:
            continue
        parsed = parse_mcq_block(qbody, five_choice=five)
        if not parsed:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_mcq_choices"
            continue
        stem, choices = parsed
        # Cap at 4 for F22 UI unless five_choice and we have E
        if not five and len(choices) > 4:
            choices = choices[:4]
        if five and len(choices) > 5:
            choices = choices[:5]
        # F22 / app historically A–D — drop E items for now (prefer reject over soft 5th)
        if five and len(choices) == 5:
            # Keep if key is A–D only; skip if key is E
            pass
        sol_body = a_blocks.get(n, "")
        key, rationale = parse_solution_block(sol_body) if sol_body else (None, "")
        if not key:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_letter_key"
            continue
        if key == "E" and not five:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "key_E_unsupported"
            continue
        if five and key == "E":
            # App/F22 locked to A–D in practice — skip E
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "key_E_skipped"
            continue
        if five and len(choices) == 5:
            # Trim E choice when key is A–D so catalog stays A–D
            choices = choices[:4]
        idx = ord(key) - ord("A")
        if idx < 0 or idx >= len(choices):
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = f"key_{key}_out_of_range_{len(choices)}"
            continue
        items.append(
            make_item(
                topic_id=spec["topic"],
                module=spec["module"],
                skill=spec["skillArea"],
                n=n,
                stem=stem,
                choices=choices,
                key=key,
                rationale=rationale,
                source_pdf=test,
                solution_pdf=ries,
                id_prefix=f"bank-{spec['id']}",
            )
        )
        info["parsed"] += 1
    return items, info


def extract_restated_pair(spec: dict) -> tuple[list[Item], dict]:
    test = find_unique(spec["test"])
    ries_matches = sorted(SOURCES.rglob(spec["riesenie"]))
    ries = ries_matches[0] if ries_matches else None
    info: dict = {
        "kind": "restated-test",
        "id": spec["id"],
        "test": str(test) if test else None,
        "riesenie": str(ries) if ries else None,
        "parsed": 0,
        "skipped": 0,
        "reasons": {},
    }
    if not test or not ries:
        info["error"] = "missing test or riesenie"
        return [], info

    q_blocks = split_numbered_blocks(pdf_text(test))
    # Solutions often restate the question — use riesenie blocks for key inference
    a_blocks = split_numbered_blocks(pdf_text(ries))
    items: list[Item] = []
    for n, qbody in sorted(q_blocks.items()):
        if n > 80:
            continue
        parsed = parse_mcq_block(qbody)
        if not parsed:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_mcq_choices"
            continue
        stem, choices = parsed
        if len(choices) > 4:
            choices = choices[:4]
        sol_body = a_blocks.get(n, qbody)
        # Try letter-first first (some hybrid docs)
        key, rationale = parse_solution_block(sol_body)
        if not key:
            key, rationale = infer_restated_key(sol_body, choices)
        if not key:
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = "no_letter_key"
            continue
        idx = ord(key) - ord("A")
        if idx < 0 or idx >= len(choices):
            info["skipped"] += 1
            info["reasons"][f"q{n}"] = f"key_{key}_out_of_range_{len(choices)}"
            continue
        items.append(
            make_item(
                topic_id=spec["topic"],
                module=spec["module"],
                skill=spec["skillArea"],
                n=n,
                stem=stem,
                choices=choices,
                key=key,
                rationale=rationale or f"Správna odpoveď: {key}.",
                source_pdf=test,
                solution_pdf=ries,
                id_prefix=f"bank-{spec['id']}",
            )
        )
        info["parsed"] += 1
    return items, info


def write_csv(items: list[Item], path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fields = [
        "id",
        "stem",
        "choices",
        "correctKey",
        "rationale",
        "module",
        "topic",
        "skillArea",
        "sourceType",
        "locale",
        "published",
        "sourcePdf",
        "solutionPdf",
        "itemIndex",
    ]
    with path.open("w", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for it in items:
            row = asdict(it)
            row["choices"] = "|".join(it.choices)
            w.writerow(row)


def main() -> int:
    all_items: list[Item] = []
    reports: list[dict] = []

    for topic in range(1, 13):
        items, info = extract_topic(topic)
        reports.append(info)
        all_items.extend(items)
        print(
            f"Ulohy T{topic}: parsed={info.get('parsed', 0)} "
            f"skipped={info.get('skipped', 0)}"
        )

    for spec in TEST_PAIRS:
        items, info = extract_letter_key_pair(spec)
        reports.append(info)
        all_items.extend(items)
        print(
            f"Test {spec['id']}: parsed={info.get('parsed', 0)} "
            f"skipped={info.get('skipped', 0)} err={info.get('error')}"
        )

    for spec in RESTATED_PAIRS:
        items, info = extract_restated_pair(spec)
        reports.append(info)
        all_items.extend(items)
        print(
            f"Restated {spec['id']}: parsed={info.get('parsed', 0)} "
            f"skipped={info.get('skipped', 0)} err={info.get('error')}"
        )

    # Deduplicate by id
    by_id: dict[str, Item] = {}
    for it in all_items:
        by_id[it.id] = it
    items = list(by_id.values())
    # Stable sort: topic, itemIndex, id
    items.sort(key=lambda x: (x.topic, x.itemIndex, x.id))
    write_csv(items, OUT_CSV)

    by_topic: dict[str, int] = {}
    for it in items:
        by_topic[it.topic] = by_topic.get(it.topic, 0) + 1

    report = {
        "generatedAt": datetime.now(timezone.utc).isoformat(),
        "source": "sources/ VSJP8 Ulohy+Riesenia + Cielene/exam pairs with parseable keys",
        "itemCount": len(items),
        "byTopicCounts": by_topic,
        "bySource": reports,
        "csv": str(OUT_CSV.relative_to(ROOT)),
        "note": (
            "Bank MCQ only (letter keys A–D). Free-answer, image-only PDFs, "
            "E-choice (X9), and unparseable restated keys skipped. "
            "SJ8/M8/AJ8 skipped when solutions lack explicit letter keys. "
            "sources/ left untouched."
        ),
    }
    OUT_REPORT.parent.mkdir(parents=True, exist_ok=True)
    OUT_REPORT.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    print(f"Wrote {len(items)} items → {OUT_CSV}")
    print(f"Report → {OUT_REPORT}")
    return 0 if items else 1


if __name__ == "__main__":
    sys.exit(main())
